<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.idempiere</groupId>
		<artifactId>org.idempiere.keikai.repository.parent</artifactId>
		<version>${revision}</version>
		<relativePath>../parent-repository-pom.xml</relativePath>
	</parent>
	<artifactId>org.idempiere.keikai.fragment</artifactId>
	<packaging>eclipse-plugin</packaging>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-keikai-runtime</id>
						<phase>validate</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>io.keikai</groupId>
									<artifactId>keikai</artifactId>
									<version>6.3.0-Eval</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.keikai</groupId>
									<artifactId>keikai-ex</artifactId>
									<version>6.3.0-Eval</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.keikai</groupId>
									<artifactId>keikai-pdf</artifactId>
									<version>6.3.0-Eval</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.keikai</groupId>
									<artifactId>keikai-model</artifactId>
									<version>6.3.0-Eval</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.zkoss.zk</groupId>
									<artifactId>zkex</artifactId>
									<version>10.0.1-Eval</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.zkoss.chart</groupId>
									<artifactId>zkcharts</artifactId>
									<version>12.2.0.0-Eval</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.keikai</groupId>
									<artifactId>poi</artifactId>
									<version>6.3.0-Eval</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.jfree</groupId>
									<artifactId>jfreechart</artifactId>
									<version>1.5.5</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.jfree</groupId>
									<artifactId>jcommon</artifactId>
									<version>1.0.24</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.jhlabs</groupId>
									<artifactId>filters</artifactId>
									<version>2.0.235-1</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.google.guava</groupId>
									<artifactId>failureaccess</artifactId>
									<version>1.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.apache.commons</groupId>
									<artifactId>commons-math3</artifactId>
									<version>3.6.1</version>
								</artifactItem>
								<artifactItem>
									<groupId>commons-io</groupId>
									<artifactId>commons-io</artifactId>
									<version>2.21.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.jsoup</groupId>
									<artifactId>jsoup</artifactId>
									<version>1.16.2</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.github.davidmoten</groupId>
									<artifactId>rtree2</artifactId>
									<version>0.9.3</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.github.librepdf</groupId>
									<artifactId>openpdf</artifactId>
									<version>1.3.30</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.apache.logging.log4j</groupId>
